{
  "productName": "Saorsa",
  "version": "0.2.7",
  "identifier": "com.saorsa.app",
  "build": {
    "devUrl": "http://localhost:8080",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Saorsa Professional",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}