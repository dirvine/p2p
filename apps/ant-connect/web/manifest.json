{
    "name": "Ant Connect - P2P Foundation",
    "short_name": "Ant Connect",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#2196f3",
    "theme_color": "#2196f3",
    "description": "Connect to the decentralized P2P Foundation network using human-friendly three-word addresses",
    "orientation": "portrait-primary",
    "prefer_related_applications": false,
    "categories": ["networking", "communication", "utilities"],
    "lang": "en",
    "dir": "ltr",
    "scope": "/",
    "icons": [
        {
            "src": "icons/Icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/Icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/Icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/Icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Quick Connect",
            "short_name": "Connect",
            "description": "Connect to P2P network quickly",
            "url": "/?action=connect",
            "icons": [{ "src": "icons/Icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Network Status",
            "short_name": "Status", 
            "description": "Check network connection status",
            "url": "/?action=status",
            "icons": [{ "src": "icons/Icon-192.png", "sizes": "192x192" }]
        }
    ],
    "share_target": {
        "action": "/share",
        "method": "GET",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },
    "protocol_handlers": [
        {
            "protocol": "web+p2p",
            "url": "/?connect=%s"
        }
    ]
}
